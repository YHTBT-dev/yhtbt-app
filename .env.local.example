# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Stripe secret key (test mode), from https://dashboard.stripe.com/test/apikeys
# Server-only — never expose this to the browser.
STRIPE_SECRET_KEY=sk_test_...

# Price ID for the "YHTBT Platform Fee" one-time price. Create it (and the
# product) by running: node --env-file=.env.local scripts/setup-stripe.mjs
STRIPE_PLATFORM_FEE_PRICE_ID=price_...

# Publishable key (test mode), from https://dashboard.stripe.com/test/apikeys
# Safe to expose client-side — used by @stripe/stripe-js to redirect to
# Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Base URL used to build Stripe Checkout's success/cancel redirect URLs.
# Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Temporary site-wide password gate for internal testing — see proxy.ts.
# Server-only; never expose this to the browser. Pick any value; this is
# NOT real security, only a front-door check while the app is being
# tested pre-launch. The underlying data (once migrated to Supabase)
# still needs its own Row Level Security policies regardless.
ADMIN_TEST_PASSWORD=choose-a-test-password

# Supabase project URL and publishable key, from your project's API
# settings in the Supabase dashboard. Both are safe to expose
# client-side. The URL is https://<project-ref>.supabase.co — not the
# dashboard URL itself.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
